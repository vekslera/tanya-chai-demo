[
  {
    "id": "LA.32.001",
    "biur": {
      "short": {
        "value": "בפרקים הקודמים למדנו לא להתרשם מהגוף ומהרצונות שלו, כי הם מסתירים את הנשמה, והיא העיקר שבנו.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "nivzeh-venimas",
        "match": "נִבְזֶה וְנִמְאָס"
      }
    ]
  },
  {
    "id": "LA.32.002",
    "biur": {
      "short": {
        "value": "והשמחה האמיתית שלנו באה מהנשמה: כל מצווה מחזירה אותה הביתה, קרוב לה׳.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.003",
    "biur": {
      "short": {
        "value": "מי שחי כך, קל לו לאהוב כל יהודי כמו את עצמו: גם את מי שעושה הרבה מצוות, וגם את מי שעושה מעט.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "veahavta",
        "match": "וְאָהַבְתָּ לְרֵעֲךָ כָּמוֹךָ"
      }
    ]
  },
  {
    "id": "LA.32.004",
    "biur": {
      "short": {
        "value": "למה זה קל? כי מי שהגוף שלו אינו חשוב בעיניו, כבר לא מרגיש ״אני יותר חשוב ממך״.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.005",
    "biur": {
      "short": {
        "value": "וגם הנשמה שלי אינה גבוהה משלך: רק ה׳ יודע כמה גדולה כל נשמה. אולי דווקא הנשמה של החבר גדולה יותר!",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "hanefesh-veharuach",
        "match": "הַנֶּפֶשׁ וְהָרוּחַ"
      },
      {
        "entryId": "beelokim-chaim",
        "match": "בֵּאלֹקִים חַיִּים"
      }
    ]
  },
  {
    "id": "LA.32.006",
    "biur": {
      "short": {
        "value": "ובאמת, בשורש שלהן כל הנשמות שוות, ומתאימות זו לזו כמו תאומים.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "matimos",
        "match": "מַתְאִימוֹת"
      }
    ]
  },
  {
    "id": "LA.32.007",
    "biur": {
      "short": {
        "value": "ויותר מזה: לכולן יש אבא אחד, הקב״ה. הן לא רק דומות, הן ממש משפחה אחת.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "av-echad",
        "match": "אָב אֶחָד"
      }
    ]
  },
  {
    "id": "LA.32.008",
    "biur": {
      "short": {
        "value": "לכן כל היהודים הם אחים אמיתיים. וכמו שאח אוהב את אחיו בלי סיבה, כך הנשמה שלי אוהבת כל יהודי.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "achim-mamash",
        "match": "״אַחִים״ מַמָּשׁ"
      }
    ]
  },
  {
    "id": "LA.32.009",
    "biur": {
      "short": {
        "value": "רק הגופים נפרדים: לכל אחד גוף משלו. מי שהגוף הוא העיקר אצלו, רואה בחבר ״מישהו אחר״, ואינו יכול לאהוב אותו באמת.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "ikar-vetafel",
        "match": "עִיקָּר וְנַפְשָׁם טְפֵלָה"
      }
    ]
  },
  {
    "id": "LA.32.010",
    "biur": {
      "short": {
        "value": "הוא אוהב רק בגלל משהו: כי החבר נחמד אליו או נותן לו. וכשהסיבה נגמרת, גם האהבה נגמרת.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "teluyah-bedavar",
        "match": "הַתְּלוּיָה בְדָבָר"
      }
    ]
  },
  {
    "id": "LA.32.011",
    "biur": {
      "short": {
        "value": "עכשיו נבין דבר מפתיע שאמר הלל הזקן: לאהוב יהודי אחר, זו כל התורה כולה!",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "hillel",
        "match": "הִלֵּל הַזָּקֵן"
      }
    ]
  },
  {
    "id": "LA.32.012",
    "biur": {
      "short": {
        "value": "ושאר התורה היא כמו פירוש של המצווה הזאת. אבל איך גם תפילין ושבת קשורות לאהבת חבר?",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "veidach",
        "match": "וְאִידָךְ פֵּירוּשָׁא הוּא"
      }
    ]
  },
  {
    "id": "LA.32.013",
    "biur": {
      "short": {
        "value": "התשובה: כל מצווה מרימה את הנשמה מעל הגוף ומקרבת אותה לה׳. וזה בדיוק מה שצריך כדי לאהוב חבר באמת.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "ikra-veshorsha",
        "match": "עִיקָּרָא וְשָׁרְשָׁא דְּכָל עָלְמִין"
      }
    ]
  },
  {
    "id": "LA.32.014",
    "biur": {
      "short": {
        "value": "והתורה פועלת גם בכיוון ההפוך: היא מורידה את האור של ה׳ אלינו, אל ״כנסת ישראל״.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "ohr-ein-sof",
        "match": "אוֹר־אֵין־סוֹף"
      },
      {
        "entryId": "knesses-yisrael",
        "match": "כְנֶסֶת יִשְׂרָאֵל"
      }
    ]
  },
  {
    "id": "LA.32.015",
    "biur": {
      "short": {
        "value": "״כנסת ישראל״ היא המקור של כל הנשמות. ה׳, שהוא אחד, מאיר שם דווקא כשגם אנחנו מאוחדים כמו אחד.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "echad-beechad",
        "match": "לְמֶהֱוֵי אֶחָד בְּאֶחָד"
      }
    ]
  },
  {
    "id": "LA.32.016",
    "biur": {
      "short": {
        "value": "אבל כשיש פירוד ומחלוקת בין יהודים, חס ושלום, האור הזה אינו מאיר.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.017",
    "biur": {
      "short": {
        "value": "כי ה׳ שורה רק במקום שלם. כשיהודים נפרדים זה מזה, חסרה השלמות, והאור של ה׳ מסתתר.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "lo-sharya",
        "match": "לָא שַׁרְיָא בַּאֲתַר פְּגִים"
      }
    ]
  },
  {
    "id": "LA.32.018",
    "biur": {
      "short": {
        "value": "לכן אנחנו מבקשים בתפילה: ״ברכנו אבינו כולנו כאחד״. כשכולנו יחד, כמו משפחה אחת, ה׳ מברך אותנו.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.019",
    "biur": {
      "short": {
        "value": "רבנו הזקן מבאר זאת באריכות במקום אחר. והעיקר כבר ברור: האהבה בינינו מביאה את האור של ה׳.",
        "reviewed": false
      }
    }
  }
]
