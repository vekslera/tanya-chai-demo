[
  {
    "id": "LA.32.001",
    "biur": {
      "short": {
        "value": "בפרקים הקודמים התבאר שאפשר להסתכל על הגוף כעל דבר נמוך ולא חשוב, שאין בו במה להתגאות.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "nivzeh-venimas",
        "match": "נִבְזֶה וְנִמְאָס"
      }
    ]
  },
  {
    "id": "LA.32.002",
    "biur": {
      "short": {
        "value": "השמחה שלו באה רק מהנשמה, מכך שהיא קרובה לה׳, ולא מדברים שהגוף נהנה מהם.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.003",
    "biur": {
      "short": {
        "value": "מי שחי כך מגיע בדרך ישרה וקלה לאהוב כל יהודי כמו את עצמו: אדם גדול וחשוב, וגם אדם פשוט.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "veahavta",
        "match": "וְאָהַבְתָּ לְרֵעֲךָ כָּמוֹךָ"
      }
    ]
  },
  {
    "id": "LA.32.004",
    "biur": {
      "short": {
        "value": "מדוע זו דרך קלה? קודם כול, כי הגוף שלו כבר אינו חשוב בעיניו.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.005",
    "biur": {
      "short": {
        "value": "ואילו הנשמה של כל יהודי גדולה מאוד, כי שורשה בה׳ עצמו. אי אפשר אפילו לשער כמה היא חשובה.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "hanefesh-veharuach",
        "match": "הַנֶּפֶשׁ וְהָרוּחַ"
      },
      {
        "entryId": "beelokim-chaim",
        "match": "בֵּאלֹקִים חַיִּים"
      }
    ]
  },
  {
    "id": "LA.32.006",
    "biur": {
      "short": {
        "value": "ועוד: כל הנשמות של ישראל דומות זו לזו ושוות, כמו תאומים.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "matimos",
        "match": "מַתְאִימוֹת"
      }
    ]
  },
  {
    "id": "LA.32.007",
    "biur": {
      "short": {
        "value": "ולכל הנשמות יש אב אחד: הקב״ה.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "av-echad",
        "match": "אָב אֶחָד"
      }
    ]
  },
  {
    "id": "LA.32.008",
    "biur": {
      "short": {
        "value": "לכן כל ישראל הם אחים באמת, ולא רק במשל: הנשמות של כולם באות מאותו מקור, מה׳ שהוא אחד.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "achim-mamash",
        "match": "״אַחִים״ מַמָּשׁ"
      }
    ]
  },
  {
    "id": "LA.32.009",
    "biur": {
      "short": {
        "value": "רק הגופים נפרדים זה מזה. לכן מי שהגוף חשוב לו יותר מהנשמה, אינו יכול לאהוב אהבת אחים אמיתית.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "ikar-vetafel",
        "match": "עִיקָּר וְנַפְשָׁם טְפֵלָה"
      }
    ]
  },
  {
    "id": "LA.32.010",
    "biur": {
      "short": {
        "value": "האהבה שלהם תהיה רק בגלל סיבה, כמו תועלת או הנאה. כשהסיבה נעלמת, גם האהבה נגמרת.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "teluyah-bedavar",
        "match": "הַתְּלוּיָה בְדָבָר"
      }
    ]
  },
  {
    "id": "LA.32.011",
    "biur": {
      "short": {
        "value": "עכשיו מובן מה שאמר הלל הזקן על מצוות אהבת ישראל: היא כל התורה כולה.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "hillel",
        "match": "הִלֵּל הַזָּקֵן"
      }
    ]
  },
  {
    "id": "LA.32.012",
    "biur": {
      "short": {
        "value": "כלומר, שאר התורה כולה הוא פירוש והרחבה של המצווה הזאת. המשפטים הבאים מבארים מדוע.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "veidach",
        "match": "וְאִידָךְ פֵּירוּשָׁא הוּא"
      }
    ]
  },
  {
    "id": "LA.32.013",
    "biur": {
      "short": {
        "value": "כל התורה באה לרומם את הנשמה מעל הגוף, ולקרב אותה עד לה׳, השורש של כל העולמות. זה בדיוק יסוד אהבת ישראל.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "ikra-veshorsha",
        "match": "עִיקָּרָא וְשָׁרְשָׁא דְּכָל עָלְמִין"
      }
    ]
  },
  {
    "id": "LA.32.014",
    "biur": {
      "short": {
        "value": "ועוד מטרה לתורה: להמשיך את אורו של הקב״ה אל ״כנסת ישראל״. בהמשך הספר זה יתבאר.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "ohr-ein-sof",
        "match": "אוֹר־אֵין־סוֹף"
      },
      {
        "entryId": "knesses-yisrael",
        "match": "כְנֶסֶת יִשְׂרָאֵל"
      }
    ]
  },
  {
    "id": "LA.32.015",
    "biur": {
      "short": {
        "value": "כנסת ישראל היא המקור שממנו באות כל הנשמות. אור ה׳, שהוא אחד, שורה שם דווקא כשגם הנשמות מאוחדות כאחד.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "echad-beechad",
        "match": "לְמֶהֱוֵי אֶחָד בְּאֶחָד"
      }
    ]
  },
  {
    "id": "LA.32.016",
    "biur": {
      "short": {
        "value": "אבל כשיש פירוד ומחלוקת בין הנשמות, חס ושלום, האור הזה אינו שורה.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.017",
    "biur": {
      "short": {
        "value": "כי הקב״ה אינו שורה במקום שיש בו פגם, ופירוד בין יהודים הוא פגם כזה.",
        "reviewed": false
      }
    },
    "glossary": [
      {
        "entryId": "lo-sharya",
        "match": "לָא שַׁרְיָא בַּאֲתַר פְּגִים"
      }
    ]
  },
  {
    "id": "LA.32.018",
    "biur": {
      "short": {
        "value": "וכך אנחנו מבקשים בתפילת שמונה עשרה: ״ברכנו אבינו כולנו כאחד״. הברכה באה כשכולנו יחד.",
        "reviewed": false
      }
    }
  },
  {
    "id": "LA.32.019",
    "biur": {
      "short": {
        "value": "הרעיון הזה מבואר בהרחבה במקום אחר.",
        "reviewed": false
      }
    }
  }
]
