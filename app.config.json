{
  "$comment": "The single place for the app's parameters. Each one is defined here once and read through src/config.ts (the app) or scripts/lib/config.ts (the scripts). Paths and text sources live in texts.config.json; colors, sizes and spacing live in src/styles/tokens.css.",
  "language": "he",
  "translationLanguage": "en",
  "storage": {
    "key": "tanyachai.demo.v1"
  },
  "levels": [
    { "id": 1, "showBiur": false },
    { "id": 2, "showBiur": true }
  ],
  "defaultLevel": 2,
  "defaultTheme": "auto",
  "demo": {
    "initialProgress": { "streak": 12, "points": 340, "heartProgress": 62, "familyStreak": 5 },
    "estimatedMinutes": 6,
    "communityLessons": 12480,
    "aboutHeartProgress": 75
  },
  "scoring": {
    "pointsByAttempt": [10, 5],
    "levelFactor": { "1": 1, "2": 2 },
    "completionBonus": 20,
    "heartStep": 3,
    "heartMax": 100
  },
  "quiz": {
    "solo": { "maxAttempts": 2 },
    "findSentence": { "choices": 3 },
    "together": { "retryUntilCorrect": true }
  },
  "motion": {
    "heartContourMs": 1200,
    "countUpMs": 900,
    "comingSoonMs": 2500,
    "done": {
      "contourAtMs": 500,
      "streakAtMs": 900,
      "pointsAtMs": 1300,
      "purifyAfterContourMs": 100
    }
  },
  "format": {
    "numberLocale": "en-US"
  },
  "text": {
    "bidiNowrapMaxChars": 30
  },
  "contentRules": {
    "biurMaxWords": { "he": 25, "en": 35 },
    "overlapRunWords": 5,
    "questions": {
      "$comment": "In each level and in Avos uBanim: this many questions after each section but the last, then one summary question. The categories each level's questions may have, and the son's. The tracks whose questions are also written in translationLanguage, for the English mode.",
      "perSection": 1,
      "levelCategories": { "1": ["literal"], "2": ["understanding", "concept"] },
      "together": { "category": "child", "kinds": ["choice", "trueFalse"] },
      "translatedTracks": ["solo"]
    },
    "optionCount": { "solo": [3, 4], "together": [2, 3] },
    "cards": { "count": [6, 8], "talks": [2, 3], "maxWords": { "forParent": 30, "toChild": 35 } }
  },
  "print": {
    "$comment": "The printable ביאור משולב (npm run print), one document per language. Word cannot use the web fonts, so each font is one of the fallbacks of its stack in tokens.css; the other sizes keep the tokens' proportions to biurPt.",
    "biurPt": 11,
    "lineSpacing": 1.6,
    "paragraphSpacingPt": 10,
    "languages": {
      "he": { "tag": "he-IL", "rtl": true, "fonts": { "text": "David", "biur": "Arial" } },
      "en": {
        "tag": "en-US",
        "rtl": false,
        "fonts": { "text": "Times New Roman", "biur": "Arial" }
      }
    }
  }
}
