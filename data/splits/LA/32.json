[
  {
    "id": "LA.32.001",
    "startsWith": "והנה, על ידי קיום"
  },
  {
    "id": "LA.32.002",
    "startsWith": "רק שמחתו תהיה"
  },
  {
    "id": "LA.32.003",
    "startsWith": "הרי זו דרך ישרה"
  },
  {
    "id": "LA.32.004",
    "startsWith": "כי מאחר שגופו נמאס"
  },
  {
    "id": "LA.32.005",
    "startsWith": "והנפש והרוח מי יודע"
  },
  {
    "id": "LA.32.006",
    "startsWith": "בשגם שכולן מתאימות"
  },
  {
    "id": "LA.32.007",
    "startsWith": "ואב אחד לכולנה"
  },
  {
    "id": "LA.32.008",
    "startsWith": "ולכן נקראו כל ישראל"
  },
  {
    "id": "LA.32.009",
    "startsWith": "רק שהגופים מחולקים"
  },
  {
    "id": "LA.32.010",
    "startsWith": "אלא התלויה בדבר"
  },
  {
    "id": "LA.32.011",
    "startsWith": "וזהו שאמר הלל הזקן"
  },
  {
    "id": "LA.32.012",
    "startsWith": "ואידך פירושא הוא"
  },
  {
    "id": "LA.32.013",
    "startsWith": "כי יסוד ושורש כל"
  },
  {
    "id": "LA.32.014",
    "startsWith": "וגם, להמשיך אור"
  },
  {
    "id": "LA.32.015",
    "startsWith": "במקור נשמות כל ישראל"
  },
  {
    "id": "LA.32.016",
    "startsWith": "ולא כשיש פירוד"
  },
  {
    "id": "LA.32.017",
    "startsWith": "ד״קודשא בריך הוא לא"
  },
  {
    "id": "LA.32.018",
    "startsWith": "וכמו שאומרים: ״ברכנו"
  },
  {
    "id": "LA.32.019",
    "startsWith": "וכמו שנתבאר במקום"
  },
  {
    "id": "LA.32.020",
    "startsWith": "ומה שכתוב בגמרא"
  },
  {
    "id": "LA.32.021",
    "startsWith": "היינו בחבירו בתורה"
  },
  {
    "id": "LA.32.022",
    "startsWith": "וכבר קיים בו מצות"
  },
  {
    "id": "LA.32.023",
    "startsWith": "עם שאתך בתורה"
  },
  {
    "id": "LA.32.024",
    "startsWith": "ואף על פי כן"
  },
  {
    "id": "LA.32.025",
    "startsWith": "כמו שכתוב בספר חרדים"
  },
  {
    "id": "LA.32.026",
    "startsWith": "אבל מי שאינו חבירו"
  },
  {
    "id": "LA.32.027",
    "startsWith": "ואינו מקורב אצלו"
  },
  {
    "id": "LA.32.028",
    "startsWith": "הנה על זה אמר"
  },
  {
    "id": "LA.32.029",
    "startsWith": "אוהב את הבריות"
  },
  {
    "id": "LA.32.030",
    "startsWith": "לומר, שאף הרחוקים"
  },
  {
    "id": "LA.32.031",
    "startsWith": "צריך למשכן"
  },
  {
    "id": "LA.32.032",
    "startsWith": "בחבלי עבותות אהבה"
  },
  {
    "id": "LA.32.033",
    "startsWith": "ואולי יוכל לקרבן"
  },
  {
    "id": "LA.32.034",
    "startsWith": "לא הפסיד שכר"
  },
  {
    "id": "LA.32.035",
    "startsWith": "וגם המקורבים אליו"
  },
  {
    "id": "LA.32.036",
    "startsWith": "ולא שבו מעונותיהם"
  },
  {
    "id": "LA.32.037",
    "startsWith": "שמצוה לשנאותם"
  },
  {
    "id": "LA.32.038",
    "startsWith": "מצוה לאהבם גם"
  },
  {
    "id": "LA.32.039",
    "startsWith": "ושתיהן הן אמת"
  },
  {
    "id": "LA.32.040",
    "startsWith": "שנאה מצד הרע"
  },
  {
    "id": "LA.32.041",
    "startsWith": "ואהבה מצד בחינת"
  },
  {
    "id": "LA.32.042",
    "startsWith": "שהוא ניצוץ אלקות"
  },
  {
    "id": "LA.32.043",
    "startsWith": "וגם, לעורר רחמים"
  },
  {
    "id": "LA.32.044",
    "startsWith": "כי היא בבחינת גלות"
  },
  {
    "id": "LA.32.045",
    "startsWith": "כנודע ממה שכתוב"
  },
  {
    "id": "LA.32.046",
    "startsWith": "[ולא אמר דוד"
  },
  {
    "id": "LA.32.047",
    "startsWith": "אלא על המינים"
  },
  {
    "id": "LA.32.048",
    "startsWith": "כדאיתא בגמרא ריש"
  }
]